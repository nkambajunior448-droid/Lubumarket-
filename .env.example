# APP_URL: URL publique de l'application Lubumarket (injectée automatiquement sur Cloud Run)
APP_URL="MY_APP_URL"

# ADMIN_BOOTSTRAP_EMAIL: Adresse email Google autorisée à initialiser le compte Administrateur Propriétaire côté serveur
ADMIN_BOOTSTRAP_EMAIL="votre-email-admin@exemple.com"

# FIREBASE_SERVICE_ACCOUNT_JSON: (Optionnel en aperçu AI Studio / Recommandé en production) Clé JSON du compte de service Firebase Admin
FIREBASE_SERVICE_ACCOUNT_JSON=""

# PRODUCTION_DOMAIN: Domaine HTTPS de production pour Digital Asset Links / Google Play TWA (à renseigner lors de la mise en production)
PRODUCTION_DOMAIN=""

# ANDROID_SHA256_CERT_FINGERPRINT: Empreinte SHA-256 du certificat de signature Google Play App Signing pour /.well-known/assetlinks.json
ANDROID_SHA256_CERT_FINGERPRINT=""

# ADAPTATEURS DE PAIEMENT (Mode test actif tant que les contrats marchands officiels ne sont pas renseignés)
MPESA_VODACOM_API_KEY=""
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
AFRIMONEY_MERCHANT_KEY=""
CARD_GATEWAY_SECRET_KEY=""

# NOTIFICATIONS EXTERNES FUTURES (Email, SMS, WhatsApp)
SMTP_API_KEY=""
SMS_GATEWAY_API_KEY=""
WHATSAPP_BUSINESS_TOKEN=""

