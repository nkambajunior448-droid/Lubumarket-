# Configuration du serveur d'authentification Lubumarket (SANS Firebase)
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Base de données SQLite locale
SQLITE_DB_PATH=./data/lubumarket_auth.sqlite

# Secret JWT (remplacer par une longue chaîne aléatoire sécurisée en production)
JWT_SECRET=CHANGEZ_MOI_SECRET_JWT_TRES_LONG_ET_ALEATOIRE_64_CHARS
JWT_EXPIRES_IN=7d

# Option A : Envoi d'emails via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Lubumarket <no-reply@lubumarket.cd>"

# Option B : Envoi d'emails via SMTP / Nodemailer (ex: Gmail App Password, Mailgun, Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
