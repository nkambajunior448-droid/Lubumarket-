            incoming().totalCommissionsUSD == existing().totalCommissionsUSD &&
            incoming().totalCommissionsCDF == existing().totalCommissionsCDF &&
            incoming().diff(existing()).affectedKeys().hasOnly(['pendingBalanceUSD', 'pendingBalanceCDF', 'lastActionRef', 'updatedAt'])) ||
          // Action 2: Atomic release of delivered + confirmed subOrder into availableBalance
          (isOwner(sellerId) &&
            exists(/databases/$(database)/documents/sellerSubOrders/$(incoming().lastActionRef)) &&
            get(/databases/$(database)/documents/sellerSubOrders/$(incoming().lastActionRef)).data.sellerId == sellerId &&
            get(/databases/$(database)/documents/sellerSubOrders/$(incoming().lastActionRef)).data.fundsReleased == false &&
            getAfter(/databases/$(database)/documents/sellerSubOrders/$(incoming().lastActionRef)).data.fundsReleased == true &&
            getAfter(/databases/$(database)/documents/sellerSubOrders/$(incoming().lastActionRef)).data.status == 'delivered' &&
            getAfter(/databases/$(database)/documents/sellerSubOrders/$(incoming().lastActionRef)).data.paymentStatus == 'confirmed' &&
            incoming().lockedWithdrawalUSD == existing().lockedWithdrawalUSD &&
            incoming().lockedWithdrawalCDF == existing().lockedWithdrawalCDF &&
            incoming().totalWithdrawalsUSD == existing().totalWithdrawalsUSD &&
            incoming().totalCommissionsUSD == existing().totalCommissionsUSD &&
            (
              (getAfter(/databases/$(database)/documents/sellerSubOrders/$(incoming().lastActionRef)).data.currency == 'USD' &&
                math.abs(incoming().availableBalanceUSD - (existing().availableBalanceUSD + getAfter(/databases/$(database)/documents/sellerSubOrders/$(incoming().lastActionRef)).data.subtotal)) < 0.001 &&
                incoming().availableBalanceCDF == existing().availableBalanceCDF) ||
              (getAfter(/databases/$(database)/documents/sellerSubOrders/$(incoming().lastActionRef)).data.currency == 'CDF' &&
                math.abs(incoming().availableBalanceCDF - (existing().availableBalanceCDF + getAfter(/databases/$(database)/documents/sellerSubOrders/$(incoming().lastActionRef)).data.subtotal)) < 0.001 &&
                incoming().availableBalanceUSD == existing().availableBalanceUSD)
