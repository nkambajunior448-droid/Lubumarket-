            // Action 2: Customer cancels while still pending/payment_pending
            (isOwner(existing().customerId) &&
              (existing().status == 'pending' || existing().status == 'payment_pending') &&
              incoming().status == 'cancelled' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            // Action 3: Customer test-mode payment confirmation synced with Payment record
            (isOwner(existing().customerId) &&
              existing().paymentMode == 'test' &&
              existing().paymentStatus == 'pending' &&
              getAfter(/databases/$(database)/documents/payments/$(orderId)).data.status == incoming().paymentStatus &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt'])) ||
            // Action 4: Participating seller or assigned courier updates workflow status ONLY
            ((request.auth.uid in existing().sellerIds || request.auth.uid in existing().courierIds) &&
