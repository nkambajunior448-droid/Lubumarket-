          // Action 3: Seller withdrawal hold (strictly deducts from availableBalance into lockedWithdrawal alongside atomic Withdrawal + 5% Commission creation)
          (isOwner(sellerId) &&
            !exists(/databases/$(database)/documents/withdrawals/$(incoming().lastActionRef)) &&
            existsAfter(/databases/$(database)/documents/withdrawals/$(incoming().lastActionRef)) &&
            existsAfter(/databases/$(database)/documents/commissions/$(incoming().lastActionRef)) &&
            getAfter(/databases/$(database)/documents/withdrawals/$(incoming().lastActionRef)).data.sellerId == sellerId &&
            getAfter(/databases/$(database)/documents/withdrawals/$(incoming().lastActionRef)).data.status == 'pending' &&
            incoming().pendingBalanceUSD == existing().pendingBalanceUSD &&
            incoming().pendingBalanceCDF == existing().pendingBalanceCDF &&
            incoming().totalSalesUSD == existing().totalSalesUSD &&
            incoming().totalSalesCDF == existing().totalSalesCDF &&
            (
              (incoming().availableBalanceUSD < existing().availableBalanceUSD &&
                math.abs((incoming().availableBalanceUSD + getAfter(/databases/$(database)/documents/withdrawals/$(incoming().lastActionRef)).data.grossAmount) - existing().availableBalanceUSD) < 0.001 &&
                math.abs(incoming().lockedWithdrawalUSD - (existing().lockedWithdrawalUSD + getAfter(/databases/$(database)/documents/withdrawals/$(incoming().lastActionRef)).data.grossAmount)) < 0.001 &&
                incoming().availableBalanceCDF == existing().availableBalanceCDF &&
                incoming().lockedWithdrawalCDF == existing().lockedWithdrawalCDF) ||
              (incoming().availableBalanceCDF < existing().availableBalanceCDF &&
