              (incoming().status == 'accepted' || incoming().status == 'preparing' || incoming().status == 'ready_for_pickup') &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
            // Action 2: Seller settles fundsReleased once delivered AND paymentStatus == confirmed
            (isOwner(existing().sellerId) &&
