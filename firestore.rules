        incoming().lockedWithdrawalUSD == 0 &&
        incoming().totalSalesUSD == 0 &&
        incoming().totalWithdrawalsUSD == 0 &&
        incoming().totalCommissionsUSD == 0 &&
        incoming().pendingBalanceCDF == 0 &&
        incoming().availableBalanceCDF == 0 &&
        incoming().lockedWithdrawalCDF == 0 &&
        incoming().totalSalesCDF == 0 &&
        incoming().totalCommissionsCDF == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isOwner(sellerId) || isAdmin());
      allow update: if isValidId(sellerId) && isVerified() && isValidWallet(incoming()) &&
        incoming().sellerId == existing().sellerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          // Action 1: Seller synchronizes non-withdrawable pendingBalance ONLY (available, locked, sales, commissions strictly unchanged)
          (isOwner(sellerId) &&
            incoming().availableBalanceUSD == existing().availableBalanceUSD &&
            incoming().availableBalanceCDF == existing().availableBalanceCDF &&
            incoming().lockedWithdrawalUSD == existing().lockedWithdrawalUSD &&
            incoming().lockedWithdrawalCDF == existing().lockedWithdrawalCDF &&
            incoming().totalSalesUSD == existing().totalSalesUSD &&
            incoming().totalSalesCDF == existing().totalSalesCDF &&
